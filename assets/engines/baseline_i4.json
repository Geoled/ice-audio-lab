{
  "$schema": "ice://schema/engine.v1.json",
  "meta": { "name": "Baseline inline-4 (S0 target)", "engine_type": "piston4t", "layout_hint": "I4" },

  "fuel": { "type": "gasoline", "molecular_afr": 14.7, "energy_density_j_per_kg": 44e6 },

  "crankshafts": [{
    "id": "c0", "throw_m": 0.043, "inertia_kgm2": 0.35, "friction_nm": 9,
    "journals": [ { "angle_deg": 0 }, { "angle_deg": 180 }, { "angle_deg": 180 }, { "angle_deg": 0 } ]
  }],

  "banks": [{
    "id": "b0", "axis_deg": 0, "bore_m": 0.086, "stroke_m": 0.086, "deck_height_m": 0.196,
    "cylinders": [
      { "crank": "c0", "journal": 0, "ignition_wire": "w1",
        "rod": { "length_m": 0.145, "mass_kg": 0.55 }, "piston": { "mass_kg": 0.42, "comp_height_m": 0.03 },
        "head": { "chamber_cc": 45, "valves": 4,
                  "cam": { "profile": "street", "lobe_sep_deg": 110 },
                  "intake_port": { "flow_k": "k_carb(220)", "runner_len_m": 0.18, "to": "pl0" },
                  "exhaust_port": { "flow_k": "k_carb(180)", "to": "col0" } } },
      { "crank": "c0", "journal": 1, "ignition_wire": "w3",
        "rod": { "ref": ".banks[0].cylinders[0].rod" }, "piston": { "ref": ".banks[0].cylinders[0].piston" },
        "head": { "chamber_cc": 45, "valves": 4,
                  "cam": { "profile": "street", "lobe_sep_deg": 110 },
                  "intake_port": { "flow_k": "k_carb(220)", "runner_len_m": 0.18, "to": "pl0" },
                  "exhaust_port": { "flow_k": "k_carb(180)", "to": "col0" } } },
      { "crank": "c0", "journal": 2, "ignition_wire": "w4",
        "rod": { "ref": ".banks[0].cylinders[0].rod" }, "piston": { "ref": ".banks[0].cylinders[0].piston" },
        "head": { "chamber_cc": 45, "valves": 4,
                  "cam": { "profile": "street", "lobe_sep_deg": 110 },
                  "intake_port": { "flow_k": "k_carb(220)", "runner_len_m": 0.18, "to": "pl0" },
                  "exhaust_port": { "flow_k": "k_carb(180)", "to": "col0" } } },
      { "crank": "c0", "journal": 3, "ignition_wire": "w2",
        "rod": { "ref": ".banks[0].cylinders[0].rod" }, "piston": { "ref": ".banks[0].cylinders[0].piston" },
        "head": { "chamber_cc": 45, "valves": 4,
                  "cam": { "profile": "street", "lobe_sep_deg": 110 },
                  "intake_port": { "flow_k": "k_carb(220)", "runner_len_m": 0.18, "to": "pl0" },
                  "exhaust_port": { "flow_k": "k_carb(180)", "to": "col0" } } }
    ]
  }],

  "camshafts": {
    "profiles": { "street": { "duration_050_deg": 226, "lift_m": 0.0098, "duration_style": "harmonic", "steps": 100, "gamma": 0.9 } },
    "actuation": "dohc_belt"
  },

  "ignition": { "firing_order": [1, 3, 4, 2], "timing_curve": [[800, 12], [3000, 30], [6500, 36]],
                "rev_limit_rpm": 6800, "limiter_style": "spark_cut" },

  "induction": {
    "type": "na",
    "plenum": { "id": "pl0", "volume_L": 3.5,
                "throttle": { "bore_m": 0.065, "gamma": 1.0 },
                "idle_circuit": { "flow_k": "k_carb(6)" } }
  },

  "exhaust": {
    "solver": { "method": "lax_wendroff", "cfl": 0.85, "nodes_per_m": 12, "wall_model": "adiabatic" },
    "nodes": [
      { "type": "collector", "id": "col0", "kind": "four_into_one", "equal_length": true,
        "primary_L_m": 0.65, "primary_d_m": 0.040, "secondary_L_m": 0.35, "secondary_d_m": 0.050, "out": "muf0",
        "tap": { "stem": "header", "gain": 0.9 } },
      { "type": "muffler", "id": "muf0", "kind": "straight_through",
        "packing": { "material": "fiberglass", "V_L": 12 }, "ir_from": "tmm",
        "tap": { "stem": "tail", "gain": 0.75 } },
      { "type": "tailpipe", "id": "t0", "length_m": 0.45, "diameter_m": 0.055, "radiation": "unflanged",
        "tap": { "stem": "tail", "gain": 1.0 } }
    ]
  },

  "audio": {
    "sim_freq_hz": "auto",
    "auto_rule": "max(22*firing_hz, 18000)",
    "sample_rate_hz": 48000,
    "jitter": 0.4, "air_noise": 0.65, "hf_gain": 0.012,
    "target_latency_s": 0.1
  }
}
